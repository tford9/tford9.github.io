---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Trenton W. Ford", description = "Trenton W. Ford — Assistant Professor of Data Science at William & Mary and Director of the Ford AI & Society (FAIS) Lab. Research and advising on AI, disinformation, and network science." } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const nav = [
  { href: "/publications", label: "Publications" },
  { href: "/talks", label: "Talks" },
  { href: "/writing", label: "Writing" },
  { href: "/teaching", label: "Teaching" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
const pageTitle = title === "Trenton W. Ford" ? title : `${title} · Trenton W. Ford`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />
    <script is:inline>
      // Set theme before paint to avoid a flash of the wrong palette.
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", stored ? stored === "dark" : prefersDark);
        } catch (_) {}
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn">Skip to content</a>

    <header class="border-b border-line">
      <div class="wrap flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <a href="/" class="display text-xl leading-none" aria-label="Home — Trenton W. Ford">Trenton W. Ford</a>
        <div class="flex items-center justify-between gap-4 sm:justify-end">
          <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-5 gap-y-1">
            {nav.map((item) => (
              <a
                href={item.href}
                class="text-sm hover:text-accent transition-colors"
                aria-current={isActive(item.href) ? "page" : undefined}
                style={isActive(item.href) ? "color: rgb(var(--accent)); font-weight: 500;" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <button
            id="themeToggle"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-line hover:border-accent transition-colors"
            aria-label="Toggle color theme"
            title="Toggle theme"
          >
            <svg class="h-4 w-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg class="hidden h-4 w-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="wrap flex-1 py-12 sm:py-16">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="wrap flex flex-col gap-2 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <span class="meta">© {new Date().getFullYear()} Trenton W. Ford</span>
        <span class="flex flex-wrap gap-x-5 gap-y-1">
          <a class="hover:text-accent transition-colors" href="mailto:twford@wm.edu">Email</a>
          <a class="hover:text-accent transition-colors" href="https://fais.wm.edu/" target="_blank" rel="noopener noreferrer">FAIS Lab</a>
          <a class="hover:text-accent transition-colors" href="https://scholar.google.com/" target="_blank" rel="noopener noreferrer">Scholar</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById("themeToggle");
      btn?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch (_) {}
      });
    </script>
  </body>
</html>
