---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getPublications } from "@/lib/bib";

const pubs = await getPublications();
// Group by year, newest first.
const byYear = new Map<number | string, typeof pubs>();
for (const p of pubs) {
  const y = p.year ?? "Undated";
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => {
  if (typeof a === "number" && typeof b === "number") return b - a;
  return typeof a === "number" ? -1 : 1;
});
---
<BaseLayout title="Publications">
  <SectionHeader as="h1" label={`${pubs.length} papers`} title="Publications" />
  <p class="max-w-read text-muted">
    Peer-reviewed work spanning computational disinformation, network science,
    human–AI teaming, and the societal impacts of AI.
  </p>

  <div class="mt-12 space-y-14">
    {years.map((year) => (
      <section>
        <h2 class="eyebrow mb-2">{year}</h2>
        <div>
          {byYear.get(year)!.map((p) => (
            <article class="entry">
              <h3 class="entry__title">
                <a href={`/publications/${p.slug}/`} class="hover:text-accent">{p.title}</a>
              </h3>
              {p.authors?.length > 0 && (
                <p class="mt-1 text-sm text-muted">{p.authors.join(", ")}</p>
              )}
              {p.venue && <p class="meta mt-1">{p.venue}</p>}
              <div class="mt-2 flex flex-wrap gap-4">
                <a class="arrow" href={`/publications/${p.slug}/`}>Details <span aria-hidden="true">→</span></a>
                {p.doi && <a class="arrow" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer">DOI <span aria-hidden="true">↗</span></a>}
                {p.url && <a class="arrow" href={p.url} target="_blank" rel="noopener noreferrer">Link <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
