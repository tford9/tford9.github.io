---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { sortedTalks, formatTalkDate, kindLabel } from "@/data/talks";

const talks = sortedTalks();
---
<BaseLayout title="Talks">
  <SectionHeader as="h1" label="Speaking" title="Talks & presentations" />
  <p class="max-w-read text-muted">
    Invited talks, seminars, and panels on AI and society, disinformation, and
    human–AI teaming. Available for keynotes, workshops, and advisory sessions.
  </p>

  <div class="mt-12">
    {talks.map((t) => (
      <article class="entry sm:grid sm:grid-cols-[8rem_1fr] sm:gap-6">
        <div class="meta pt-1">
          <div>{formatTalkDate(t.date)}</div>
          {t.kind && <div class="mt-1 text-accent">{kindLabel[t.kind]}</div>}
        </div>
        <div>
          <h2 class="entry__title">{t.title}</h2>
          <p class="mt-1 text-sm text-muted">
            {t.event}{t.location ? ` · ${t.location}` : ""}
          </p>
          {(t.href || t.links || t.materials) && (
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
              {t.href && <a class="arrow" href={t.href}>Materials &amp; slides <span aria-hidden="true">→</span></a>}
              {t.links?.slides && <a class="arrow" href={t.links.slides} target="_blank" rel="noopener noreferrer">Slides <span aria-hidden="true">↗</span></a>}
              {t.links?.video && <a class="arrow" href={t.links.video} target="_blank" rel="noopener noreferrer">Video <span aria-hidden="true">↗</span></a>}
              {t.links?.paper && <a class="arrow" href={t.links.paper} target="_blank" rel="noopener noreferrer">Paper <span aria-hidden="true">↗</span></a>}
              {t.materials?.map((m) => (
                <a class="arrow" href={m.href} download>{m.label} <span aria-hidden="true">↓</span></a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
