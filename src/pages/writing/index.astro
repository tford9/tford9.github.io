---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---
<BaseLayout title="Writing">
  <SectionHeader as="h1" label="Articles & notes" title="Writing" />
  <p class="max-w-read text-muted">
    Essays, op-eds, and shorter notes on artificial intelligence, disinformation,
    and the public understanding of data science.
  </p>

  <div class="mt-12">
    {entries.map((e) => {
      const external = Boolean(e.data.link);
      const href = e.data.link ?? `/writing/${e.slug}/`;
      return (
        <article class="entry">
          <div class="flex items-center gap-3">
            <span class="meta">{new Date(e.data.pubDate).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}</span>
            <span class="chip">{e.data.kind === "article" ? "article" : "note"}</span>
            {external && <span class="chip">external</span>}
          </div>
          <h2 class="entry__title mt-2">
            <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="hover:text-accent">
              {e.data.title} {external && <span aria-hidden="true" class="text-accent">↗</span>}
            </a>
          </h2>
          {e.data.description && <p class="mt-1 text-sm leading-relaxed text-muted max-w-read">{e.data.description}</p>}
          {e.data.tags && e.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {e.data.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          )}
        </article>
      );
    })}
  </div>
</BaseLayout>
